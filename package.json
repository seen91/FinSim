{
  "name": "finsim",
  "private": true,
  "type": "module",
  "workspaces": [
    "engine",
    "app"
  ],
  "scripts": {
    "test": "npm --workspace @finsim/engine run test",
    "typecheck": "npm --workspace @finsim/engine run typecheck && npm --workspace @finsim/app run typecheck",
    "dev": "npm --workspace @finsim/app run dev",
    "build": "npm --workspace @finsim/app run build"
  }
}
